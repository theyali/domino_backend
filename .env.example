DJANGO_SECRET_KEY=change-me-before-public-use
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=domino
POSTGRES_USER=domino
POSTGRES_PASSWORD=change-me-postgres-password

# Host ports. PostgreSQL itself is not published; PgBouncer is available only on localhost.
PGBOUNCER_HOST_PORT=6433
REDIS_HOST_PORT=6380
WEB_BIND=0.0.0.0
WEB_PORT=8000

# PgBouncer uses transaction pooling, so Django should keep its own DB connections short-lived.
DB_CONN_MAX_AGE=0
DB_DISABLE_SERVER_SIDE_CURSORS=1
